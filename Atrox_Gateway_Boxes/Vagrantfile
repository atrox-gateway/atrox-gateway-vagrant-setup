Vagrant.configure("2") do |config|  
  # IMPORTANT: set VAGRANT_PASSWORD in your host environment before running
  # `vagrant up` so provisioning can perform user creation and optional
  # ssh-copy-id propagation without embedding secrets in the repo. Example:
  #
  #   export VAGRANT_PASSWORD='your-temp-password'
  #   vagrant up --provider=virtualbox
  #
  # The password is used transiently during provisioning only and is NOT
  # committed to the repository.
  config.vm.synced_folder ".", "/vagrant", disabled: true
  config.vm.define "node-storage" do |storage|
    storage.vm.box = "atrox-gateway/node-storage"
    storage.vm.box_version = "1.0.0"    
    storage.vm.hostname = "node-storage"
    storage.vm.network "private_network", ip: "192.168.56.12"
    storage.vm.provider "virtualbox" do |vb|
      vb.memory = 1024
      vb.cpus = 1
    end
    storage.ssh.insert_key = false
    storage.ssh.password = ENV['VAGRANT_PASSWORD']
  end
  
  config.vm.define "node-login" do |login|
    login.vm.box = "atrox-gateway/node-login"
    login.vm.box_version = "1.0.0"    
    login.vm.hostname = "node-login"
    login.vm.network "private_network", ip: "192.168.56.11"
    login.vm.provider "virtualbox" do |vb|
      vb.memory = 4096
      vb.cpus = 4
    end
    login.ssh.insert_key = false
    login.ssh.password = ENV['VAGRANT_PASSWORD']
  end

  config.vm.define "node-01" do |node01|
    node01.vm.box = "atrox-gateway/node-01"
    node01.vm.box_version = "1.0.0"    
    node01.vm.hostname = "node-01"
    node01.vm.network "private_network", ip: "192.168.56.13"
    node01.vm.provider "virtualbox" do |vb|
      vb.memory = 2048
      vb.cpus = 2
    end
    node01.ssh.insert_key = false
    node01.ssh.password = ENV['VAGRANT_PASSWORD']
  end

  config.vm.define "node-02" do |node02|
    node02.vm.box = "atrox-gateway/node-02"
    node02.vm.box_version = "1.0.0"
    node02.vm.hostname = "node-02"
    node02.vm.network "private_network", ip: "192.168.56.14"
    node02.vm.provider "virtualbox" do |vb|
      vb.memory = 2048
      vb.cpus = 2
    end
    node02.ssh.insert_key = false
    node02.ssh.password = ENV['VAGRANT_PASSWORD']
  end
  
  config.vm.define "node-app" do |app|
    app.vm.box = "atrox-gateway/node-app"
    app.vm.box_version = "1.0.0"
    app.vm.hostname = "node-app"
    app.vm.network "private_network", ip: "192.168.56.10"
    app.vm.network "public_network", bridge: "wlp6s0", auto_config: true
    app.vm.provider "virtualbox" do |vb|
      vb.memory = 4096
      vb.cpus = 4
    end
    app.ssh.insert_key = false
    app.ssh.password = ENV['VAGRANT_PASSWORD']
    app.vm.provision "file", source: "cleanup.sh", destination: "/tmp/cleanup.sh"
    app.vm.provision "shell", inline: <<-SHELL, privileged: true, run: "always"
      sudo chmod +x /tmp/cleanup.sh || true
      # Pass the host-provisioning password into the script explicitly so it can
      # perform ssh-copy-id via sshpass when needed. Do not commit any secret.
      sudo ATROX_PASSWORD='#{ENV['ATROX_PASSWORD']}' /tmp/cleanup.sh || true
    SHELL
  end
end

